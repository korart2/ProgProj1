{
  "version": 3,
  "configurePresets": [
    {
      "name": "x64-msvc-ninja",
      "displayName": "x64 MSVC with Ninja",
      "description": "Uses Ninja generator and MSVC compiler for 64-bit builds",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-msvc-ninja",
      "configurePreset": "x64-msvc-ninja"
    }
  ]
}